<!DOCTYPE html>
<html lang="id" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BloxZone Store - Kebutuhan Roblox Terlengkap</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;800;900&family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        neonBlue: '#00f0ff',
                        neonPurple: '#7000ff',
                        darkBg: '#0a0a12',
                        darkCard: '#121225',
                        darkBorder: '#1f1f3e',
                    },
                    fontFamily: {
                        orbitron: ['Orbitron', 'sans-serif'],
                        rajdhani: ['Rajdhani', 'sans-serif'],
                    },
                    boxShadow: {
                        glowBlue: '0 0 20px rgba(0, 240, 255, 0.4)',
                        glowPurple: '0 0 20px rgba(112, 0, 255, 0.4)',
                        cardGlow: '0 4px 25px rgba(0, 0, 0, 0.6), 0 0 10px rgba(112, 0, 255, 0.2)'
                    }
                }
            }
        }
    </script>

    <style>
        body {
            background-color: #0a0a12;
            color: #e2e8f0;
            font-family: 'Rajdhani', sans-serif;
            overflow-x: hidden;
            background-image: 
                radial-gradient(circle at 10% 20%, rgba(112, 0, 255, 0.15) 0%, transparent 40%),
                radial-gradient(circle at 90% 80%, rgba(0, 240, 255, 0.12) 0%, transparent 40%);
            background-attachment: fixed;
        }

        .font-header {
            font-family: 'Orbitron', sans-serif;
        }

        .neon-border {
            border: 1px solid rgba(0, 240, 255, 0.3);
            transition: all 0.3s ease;
        }

        .neon-border:hover {
            border-color: #00f0ff;
            box-shadow: 0 0 15px rgba(0, 240, 255, 0.5);
        }

        .purple-border {
            border: 1px solid rgba(112, 0, 255, 0.3);
            transition: all 0.3s ease;
        }

        .purple-border:hover {
            border-color: #7000ff;
            box-shadow: 0 0 15px rgba(112, 0, 255, 0.5);
        }

        .glass-card {
            background: rgba(18, 18, 37, 0.75);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #0a0a12;
        }
        ::-webkit-scrollbar-thumb {
            background: #1f1f3e;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #7000ff;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between">

    <header class="sticky top-0 z-40 glass-card border-b border-darkBorder/60 shadow-lg">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <a href="#" onclick="playSound(); showSection('hero')" class="flex items-center space-x-3 group">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-neonPurple to-neonBlue flex items-center justify-center text-black font-black text-xl font-header shadow-glowBlue transition transform group-hover:scale-105">
                    BZ
                </div>
                <div>
                    <span class="font-header text-2xl font-black tracking-wider bg-clip-text text-transparent bg-gradient-to-r from-neonBlue via-white to-neonPurple">
                        BLOXZONE
                    </span>
                    <span class="block text-[10px] tracking-widest text-cyan-400 font-header uppercase -mt-1">STORE</span>
                </div>
            </a>

            <div class="hidden md:flex items-center space-x-6">
                <div class="relative">
                    <input type="text" id="searchInput" onkeyup="filterProducts()" placeholder="Cari layanan Roblox..." class="w-56 bg-darkBg/80 border border-darkBorder rounded-full py-2 px-4 pl-10 text-sm text-gray-200 focus:outline-none focus:border-neonBlue focus:ring-1 focus:ring-neonBlue transition">
                    <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-3 text-gray-400 text-sm"></i>
                </div>

                <nav class="flex items-center space-x-4 text-sm font-semibold tracking-wide">
                    <button onclick="playSound(); showSection('hero')" class="hover:text-neonBlue transition">Beranda</button>
                    <button onclick="playSound(); scrollToProducts()" class="hover:text-neonBlue transition">Produk</button>
                    <button onclick="playSound(); openCekPesananModal()" class="text-cyan-300 hover:text-neonBlue transition flex items-center gap-1.5 bg-cyan-950/30 px-3 py-1.5 rounded-lg border border-cyan-500/30">
                        <i class="fa-solid fa-receipt text-xs"></i> Cek Pesanan
                    </button>
                    <button onclick="playSound(); toggleSoundPreference()" id="soundToggleBtn" class="px-3 py-1.5 rounded-lg border border-cyan-500/40 text-cyan-300 hover:bg-cyan-500/20 transition flex items-center gap-2" title="Aktifkan/Matikan Suara">
                        <i id="soundIcon" class="fa-solid fa-volume-high text-xs"></i> <span id="soundText" class="text-xs">Audio On</span>
                    </button>
                    <button onclick="playSound(); openAdminModal()" class="px-3 py-1.5 rounded-lg border border-purple-500/40 text-purple-300 hover:bg-purple-600/20 transition flex items-center gap-2">
                        <i class="fa-solid fa-lock text-xs"></i> Admin Panel
                    </button>
                </nav>
            </div>

            <div class="md:hidden flex items-center space-x-3">
                <button onclick="playSound(); openCekPesananModal()" class="text-cyan-300 p-2 text-lg" title="Cek Pesanan">
                    <i class="fa-solid fa-receipt"></i>
                </button>
                <button onclick="playSound(); toggleSoundPreference()" class="text-cyan-400 p-2 text-lg">
                    <i id="soundIconMob" class="fa-solid fa-volume-high"></i>
                </button>
                <button onclick="playSound(); openAdminModal()" class="text-purple-400 p-2 text-lg">
                    <i class="fa-solid fa-user-shield"></i>
                </button>
            </div>
        </div>
    </header>

    <div id="toast" class="fixed bottom-5 right-5 z-50 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none">
        <div class="glass-card px-5 py-3 rounded-xl border border-neonBlue flex items-center gap-3 shadow-glowBlue text-white">
            <i id="toastIcon" class="fa-solid fa-circle-check text-neonBlue text-xl"></i>
            <span id="toastMsg" class="font-medium text-sm">Notifikasi</span>
        </div>
    </div>

    <main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">

        <section id="hero-section" class="mb-16">
            <div class="relative rounded-3xl overflow-hidden glass-card p-8 md:p-14 border border-neonPurple/30 shadow-cardGlow">
                <div class="absolute -top-24 -right-24 w-96 h-96 bg-neonPurple/20 rounded-full blur-3xl pointer-events-none"></div>
                <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-neonBlue/20 rounded-full blur-3xl pointer-events-none"></div>

                <div class="relative z-10 max-w-3xl">
                    <div class="flex flex-wrap items-center gap-3 mb-4">
                        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold font-header tracking-wider bg-neonPurple/20 text-purple-300 border border-purple-500/30">
                            <i class="fa-solid fa-bolt text-yellow-400"></i> STORE RESMI & TERPERCAYA
                        </span>
                        <!-- Visitor Counter Badge -->
                        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold font-header tracking-wider bg-cyan-950/50 text-cyan-300 border border-cyan-500/30 shadow-glowBlue">
                            <i class="fa-solid fa-users text-neonBlue"></i> Pengunjung: <span id="visitorCountDisplay" class="text-white font-black">2.490</span>
                        </div>
                    </div>

                    <h1 class="font-header text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white mb-4 leading-tight">
                        SELAMAT DATANG DI <span class="bg-clip-text text-transparent bg-gradient-to-r from-neonBlue to-purple-500">BLOXZONE</span>
                    </h1>
                    <p class="font-header text-lg sm:text-xl text-cyan-300 mb-4 font-semibold">
                        Kebutuhan Roblox Terlengkap!
                    </p>
                    <p class="text-gray-300 text-base sm:text-lg mb-8 leading-relaxed max-w-2xl">
                        Temukan berbagai layanan Roblox dengan pilihan produk yang lengkap, harga yang jelas, proses pemesanan yang praktis, dan bantuan admin yang mudah dihubungi.
                    </p>

                    <div class="flex flex-wrap gap-4">
                        <button onclick="playSound(); scrollToProducts()" class="px-6 py-3.5 rounded-xl font-header font-bold text-sm bg-gradient-to-r from-neonBlue to-blue-600 text-black hover:shadow-glowBlue transition transform hover:-translate-y-0.5 flex items-center gap-2">
                            <i class="fa-solid fa-cart-shopping"></i> Lihat Semua Produk
                        </button>
                        <button onclick="playSound(); openCekPesananModal()" class="px-6 py-3.5 rounded-xl font-header font-bold text-sm bg-darkCard border border-cyan-400/50 text-cyan-300 hover:bg-cyan-500/10 transition flex items-center gap-2">
                            <i class="fa-solid fa-receipt"></i> Cek Status Pesanan
                        </button>
                        <a id="heroWaBtn" href="#" target="_blank" onclick="playSound()" class="px-6 py-3.5 rounded-xl font-header font-bold text-sm bg-green-600/20 border border-green-500/50 text-green-400 hover:bg-green-600/30 transition flex items-center gap-2">
                            <i class="fa-brands fa-whatsapp text-lg"></i> Hubungi Admin
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <div class="md:hidden mb-8">
            <input type="text" id="searchInputMobile" onkeyup="filterProductsMobile()" placeholder="Cari layanan Roblox..." class="w-full bg-darkCard border border-darkBorder rounded-xl py-3 px-4 text-sm text-gray-200 focus:outline-none focus:border-neonBlue">
        </div>

        <div id="products-anchor" class="space-y-16">

            <!-- PRODUCT 1: VERIFIKASI UMUR ROBLOX -->
            <section id="category-verif" class="product-category-block">
                <div class="flex items-center justify-between mb-6 border-b border-darkBorder pb-3">
                    <div class="flex items-center gap-3">
                        <div class="p-2 rounded-lg bg-neonBlue/10 text-neonBlue text-xl">
                            <i class="fa-solid fa-id-card"></i>
                        </div>
                        <div>
                            <h2 class="font-header text-xl sm:text-2xl font-bold text-white tracking-wide">1. VERIFIKASI UMUR ROBLOX</h2>
                            <p class="text-xs text-gray-400">Pilih layanan verifikasi umur sesuai kebutuhan. Cukup Username (USN), Tanpa Login!</p>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div class="glass-card rounded-2xl p-6 neon-border flex flex-col justify-between relative overflow-hidden group">
                        <div class="absolute top-0 right-0 bg-neonBlue/20 text-neonBlue font-header text-[10px] font-bold px-3 py-1 rounded-bl-xl border-l border-b border-neonBlue/30">
                            PROMO
                        </div>
                        <div>
                            <div class="text-3xl font-header font-extrabold text-white mb-2">16 TAHUN</div>
                            <p class="text-xs text-gray-400 mb-4">Verifikasi umur akun Roblox menjadi 16+ tahun secara aman.</p>
                            <div class="text-2xl font-header font-black text-neonBlue mb-6">Rp7.000</div>
                        </div>
                        <button onclick="playSound(); selectPackage('Verifikasi Umur 16 Tahun', 7000, 'verif', 'Username Roblox (USN)')" class="w-full py-3 rounded-xl font-header font-bold text-sm bg-neonBlue/20 text-neonBlue border border-neonBlue/50 hover:bg-neonBlue hover:text-black transition flex items-center justify-center gap-2">
                            <i class="fa-solid fa-cart-plus"></i> Beli Sekarang
                        </button>
                    </div>

                    <div class="glass-card rounded-2xl p-6 purple-border flex flex-col justify-between relative overflow-hidden group">
                        <div>
                            <div class="text-3xl font-header font-extrabold text-white mb-2">19 TAHUN</div>
                            <p class="text-xs text-gray-400 mb-4">Akses fitur eksklusif usia 19+ tanpa ribet dokumen.</p>
                            <div class="text-2xl font-header font-black text-purple-400 mb-6">Rp15.000</div>
                        </div>
                        <button onclick="playSound(); selectPackage('Verifikasi Umur 19 Tahun', 15000, 'verif', 'Username Roblox (USN)')" class="w-full py-3 rounded-xl font-header font-bold text-sm bg-purple-600/20 text-purple-300 border border-purple-500/50 hover:bg-purple-600 hover:text-white transition flex items-center justify-center gap-2">
                            <i class="fa-solid fa-cart-plus"></i> Beli Sekarang
                        </button>
                    </div>

                    <div class="glass-card rounded-2xl p-6 neon-border flex flex-col justify-between relative overflow-hidden group">
                        <div>
                            <div class="text-3xl font-header font-extrabold text-white mb-2">21 TAHUN</div>
                            <p class="text-xs text-gray-400 mb-4">Membuka semua batasan umur akun Roblox (21+ Mature).</p>
                            <div class="text-2xl font-header font-black text-neonBlue mb-6">Rp30.000</div>
                        </div>
                        <button onclick="playSound(); selectPackage('Verifikasi Umur 21 Tahun', 30000, 'verif', 'Username Roblox (USN)')" class="w-full py-3 rounded-xl font-header font-bold text-sm bg-neonBlue/20 text-neonBlue border border-neonBlue/50 hover:bg-neonBlue hover:text-black transition flex items-center justify-center gap-2">
                            <i class="fa-solid fa-cart-plus"></i> Beli Sekarang
                        </button>
                    </div>
                </div>
            </section>

            <!-- PRODUCT 2: ROBLOX TOP UP ROBUX -->
            <section id="category-robux" class="product-category-block">
                <div class="glass-card rounded-3xl p-6 sm:p-8 border border-neonBlue/30 relative overflow-hidden">
                    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8 border-b border-darkBorder pb-6">
                        <div>
                            <div class="flex items-center gap-2 text-neonBlue font-header font-bold text-xs uppercase tracking-wider mb-1">
                                <i class="fa-solid fa-gem"></i> Direct Top Up
                            </div>
                            <h2 class="font-header text-2xl sm:text-3xl font-extrabold text-white">🎮 ROBLOX TOP UP ROBUX 🎮</h2>
                            <p class="text-sm text-cyan-300 font-semibold mt-1">✨ Main Roblox Jadi Lebih Seru! 💎 LEBIH MURAH • AMAN • PROSES CEPAT</p>
                        </div>
                        <div class="bg-darkBg/60 px-4 py-2 rounded-xl border border-neonBlue/30 text-xs text-gray-300">
                            <i class="fa-solid fa-shield-halved text-neonBlue mr-1"></i> Hanya Butuh Username Roblox (USN)
                        </div>
                    </div>

                    <div id="robux-packages-container" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
                        <!-- Rendered by JS -->
                    </div>

                    <div class="mt-10 p-6 rounded-2xl bg-darkBg/80 border border-darkBorder">
                        <h3 class="font-header text-sm font-bold text-white mb-4 flex items-center gap-2">
                            <i class="fa-solid fa-shield-heart text-neonBlue"></i> KENAPA MEMILIH BLOXZONE?
                        </h3>
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs text-gray-300">
                            <div class="flex items-start gap-2"><i class="fa-solid fa-check text-green-400 mt-0.5"></i> <span>Mengutamakan keamanan akun dan data pelanggan.</span></div>
                            <div class="flex items-start gap-2"><i class="fa-solid fa-bolt text-yellow-400 mt-0.5"></i> <span>Proses pesanan yang praktis dan transparan.</span></div>
                            <div class="flex items-start gap-2"><i class="fa-solid fa-tags text-neonBlue mt-0.5"></i> <span>Banyak pilihan paket harga kompetitif.</span></div>
                            <div class="flex items-start gap-2"><i class="fa-solid fa-headset text-purple-400 mt-0.5"></i> <span>Dukungan admin responsif membantu pelanggan.</span></div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- PRODUCT 3: JUAL AKUN ROBLOX -->
            <section id="category-sell" class="product-category-block">
                <div class="glass-card rounded-3xl p-6 sm:p-10 border border-purple-500/30">
                    <div class="max-w-3xl mx-auto text-center mb-8">
                        <span class="px-3 py-1 rounded-full text-xs font-bold font-header bg-purple-600/20 text-purple-300 border border-purple-500/30">
                            <i class="fa-solid fa-handshake"></i> LAYANAN MITRA
                        </span>
                        <h2 class="font-header text-2xl sm:text-3xl font-extrabold text-white mt-3">PUNYA AKUN ROBLOX YANG INGIN DIJUAL?</h2>
                        <p class="text-sm text-gray-300 mt-2">Tawarkan akun Roblox kamu kepada admin BloxZone dengan harga bersaing!</p>
                    </div>

                    <form id="sellAccountForm" onsubmit="playSound(); handleAccountOffer(event)" class="max-w-xl mx-auto space-y-4">
                        <div>
                            <label class="block text-xs font-header uppercase font-bold text-gray-300 mb-1">Username Roblox (USN)</label>
                            <input type="text" id="sellUsn" required placeholder="Contoh: RobloxPlayer123" class="w-full bg-darkBg border border-darkBorder rounded-xl p-3 text-sm text-white focus:border-purple-500 focus:outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-header uppercase font-bold text-gray-300 mb-1">Deskripsi Akun & Detail Item</label>
                            <textarea id="sellDesc" rows="4" required placeholder="Jelaskan level, inventory, gamepass, Robux tersisa, dll..." class="w-full bg-darkBg border border-darkBorder rounded-xl p-3 text-sm text-white focus:border-purple-500 focus:outline-none"></textarea>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-header uppercase font-bold text-gray-300 mb-1">Harga Ditawarkan (Rp)</label>
                                <input type="number" id="sellPrice" required placeholder="Contoh: 150000" class="w-full bg-darkBg border border-darkBorder rounded-xl p-3 text-sm text-white focus:border-purple-500 focus:outline-none">
                            </div>
                            <div>
                                <label class="block text-xs font-header uppercase font-bold text-gray-300 mb-1">Nomor WhatsApp Active</label>
                                <input type="tel" id="sellWa" required placeholder="08xxxxxxxxxx" class="w-full bg-darkBg border border-darkBorder rounded-xl p-3 text-sm text-white focus:border-purple-500 focus:outline-none">
                            </div>
                        </div>
                        <div class="bg-yellow-500/10 border border-yellow-500/30 rounded-xl p-3 text-xs text-yellow-300/90 flex items-center gap-2">
                            <i class="fa-solid fa-lock text-sm"></i>
                            <span>Catatan: Jangan memberikan password akun atau kode verifikasi pada formulir ini. Pembahasan detail dilakukan aman via WhatsApp admin.</span>
                        </div>
                        <button type="submit" class="w-full py-3.5 rounded-xl font-header font-bold text-sm bg-gradient-to-r from-purple-600 to-indigo-600 text-white hover:shadow-glowPurple transition">
                            <i class="fa-solid fa-paper-plane mr-2"></i> Tawarkan Akun ke Admin
                        </button>
                    </form>
                </div>
            </section>

            <!-- PRODUCT 4: JASA JOKI STEAL AN EGG -->
            <section id="category-joki" class="product-category-block">
                <div class="flex items-center justify-between mb-6 border-b border-darkBorder pb-3">
                    <div class="flex items-center gap-3">
                        <div class="p-2 rounded-lg bg-purple-600/20 text-purple-400 text-xl">
                            <i class="fa-solid fa-egg"></i>
                        </div>
                        <div>
                            <h2 class="font-header text-xl sm:text-2xl font-bold text-white tracking-wide">🎮 JASA JOKI STEAL AN EGG</h2>
                            <p class="text-xs text-gray-400">Pilih durasi layanan sesuai kebutuhan kamu!</p>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
                    <div class="glass-card p-4 rounded-xl purple-border text-center flex flex-col justify-between">
                        <div>
                            <div class="text-lg font-header font-bold text-white">3 HARI</div>
                            <div class="text-neonBlue font-header font-extrabold text-xl my-2">Rp15.000</div>
                        </div>
                        <button onclick="playSound(); selectPackage('Joki Steal An Egg (3 Hari)', 15000, 'joki')" class="w-full py-2 mt-2 rounded-lg text-xs font-header font-bold bg-purple-600/30 border border-purple-500/40 text-purple-200 hover:bg-purple-600">Beli Sekarang</button>
                    </div>

                    <div class="glass-card p-4 rounded-xl purple-border text-center flex flex-col justify-between">
                        <div>
                            <div class="text-lg font-header font-bold text-white">7 HARI</div>
                            <div class="text-neonBlue font-header font-extrabold text-xl my-2">Rp20.000</div>
                        </div>
                        <button onclick="playSound(); selectPackage('Joki Steal An Egg (7 Hari)', 20000, 'joki')" class="w-full py-2 mt-2 rounded-lg text-xs font-header font-bold bg-purple-600/30 border border-purple-500/40 text-purple-200 hover:bg-purple-600">Beli Sekarang</button>
                    </div>

                    <div class="glass-card p-4 rounded-xl purple-border text-center flex flex-col justify-between">
                        <div>
                            <div class="text-lg font-header font-bold text-white">10 HARI</div>
                            <div class="text-neonBlue font-header font-extrabold text-xl my-2">Rp25.000</div>
                        </div>
                        <button onclick="playSound(); selectPackage('Joki Steal An Egg (10 Hari)', 25000, 'joki')" class="w-full py-2 mt-2 rounded-lg text-xs font-header font-bold bg-purple-600/30 border border-purple-500/40 text-purple-200 hover:bg-purple-600">Beli Sekarang</button>
                    </div>

                    <div class="glass-card p-4 rounded-xl purple-border text-center flex flex-col justify-between">
                        <div>
                            <div class="text-lg font-header font-bold text-white">15 HARI</div>
                            <div class="text-neonBlue font-header font-extrabold text-xl my-2">Rp27.000</div>
                        </div>
                        <button onclick="playSound(); selectPackage('Joki Steal An Egg (15 Hari)', 27000, 'joki')" class="w-full py-2 mt-2 rounded-lg text-xs font-header font-bold bg-purple-600/30 border border-purple-500/40 text-purple-200 hover:bg-purple-600">Beli Sekarang</button>
                    </div>

                    <div class="glass-card p-4 rounded-xl purple-border text-center flex flex-col justify-between">
                        <div>
                            <div class="text-lg font-header font-bold text-white">20 HARI</div>
                            <div class="text-neonBlue font-header font-extrabold text-xl my-2">Rp35.000</div>
                        </div>
                        <button onclick="playSound(); selectPackage('Joki Steal An Egg (20 Hari)', 35000, 'joki')" class="w-full py-2 mt-2 rounded-lg text-xs font-header font-bold bg-purple-600/30 border border-purple-500/40 text-purple-200 hover:bg-purple-600">Beli Sekarang</button>
                    </div>

                    <div class="glass-card p-4 rounded-xl neon-border text-center flex flex-col justify-between bg-neonPurple/10">
                        <div>
