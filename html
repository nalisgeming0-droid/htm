            document.getElementById('products-anchor').scrollIntoView({ behavior: 'smooth' });
        }

        window.scrollToCategory = function(catId) {
            document.getElementById(`category-${catId}`).scrollIntoView({ behavior: 'smooth' });
        }

        window.filterProducts = function() {
            const val = document.getElementById('searchInput').value.toLowerCase();
            document.querySelectorAll('.product-category-block').forEach(b => {
                b.style.display = b.innerText.toLowerCase().includes(val) ? 'block' : 'none';
            });
        }

        window.filterProductsMobile = function() {
            const val = document.getElementById('searchInputMobile').value.toLowerCase();
            document.querySelectorAll('.product-category-block').forEach(b => {
                b.style.display = b.innerText.toLowerCase().includes(val) ? 'block' : 'none';
            });
        }

        window.onload = () => {
            initFirebase();
        };
    </script>
</body>
</html>
