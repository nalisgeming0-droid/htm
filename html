                if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                    const cred = await signInWithCustomToken(auth, __initial_auth_token);
                    currentUser = cred.user;
                } else {
                    const cred = await signInAnonymously(auth);
                    currentUser = cred.user;
                }

                // Initialize Visitor Counter
                initVisitorCounter();

                // Realtime Sync Store Settings
                const settingsRef = doc(db, 'artifacts', appId, 'public', 'data', 'config', 'storeSettings');
                onSnapshot(settingsRef, (snap) => {
                    if (snap.exists()) {
                        storeSettings = { ...storeSettings, ...snap.data() };
                        updateUIWithSettings();
                    }
                }, (err) => console.log("Settings offline mode"));

                // Realtime Sync Robux Packages
                const packagesRef = collection(db, 'artifacts', appId, 'public', 'data', 'robuxPackages');
                onSnapshot(packagesRef, (snap) => {
                    if (!snap.empty) {
                        robuxPackages = snap.docs.map(d => ({ id: d.id, ...d.data() }));
                        renderRobuxPackages();
                    } else {
                        renderRobuxPackages();
                    }
                }, (err) => renderRobuxPackages());

                // Realtime Sync Orders History & Approvals
                const ordersRef = collection(db, 'artifacts', appId, 'public', 'data', 'orders');
                onSnapshot(ordersRef, (snap) => {
                    if (!snap.empty) {
                        activeOrdersCache = snap.docs.map(d => ({ id: d.id, ...d.data() }));
                        renderOrdersTable(activeOrdersCache);
                        renderPendingOrdersTable(activeOrdersCache);
                        checkActiveOrderLiveStatus(activeOrdersCache);
                    }
                }, (err) => {});

