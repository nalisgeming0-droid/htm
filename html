            onSnapshot(counterRef, (snap) => {
                let count = 2490;
                if (snap.exists() && typeof snap.data().count === 'number') {
                    count = snap.data().count;
                } else {
                    setDoc(counterRef, { count: 2490 }, { merge: true });
                }
                const disp = document.getElementById('visitorCountDisplay');
                const adminInput = document.getElementById('adminVisitorCountInput');
                if (disp) disp.innerText = count.toLocaleString('id-ID');
                if (adminInput) adminInput.value = count;
            }, (err) => {});

            if (!sessionStorage.getItem(visitedKey)) {
                sessionStorage.setItem(visitedKey, 'true');
                try {
                    const snap = await getDoc(counterRef);
                    let currentCount = 2490;
                    if (snap.exists() && typeof snap.data().count === 'number') {
                        currentCount = snap.data().count;
                    }
                    await setDoc(counterRef, { count: currentCount + 1 }, { merge: true });
                } catch(e) {}
            }
        }

